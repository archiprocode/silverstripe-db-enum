parameters:
  level: 8
  paths:
    - src
  treatPhpDocTypesAsCertain: false
  checkMissingIterableValueType: true
  checkGenericClassInNonGenericObjectType: true
  reportUnmatchedIgnoredErrors: true

  # Ignore SilverStripe framework specific issues
  ignoreErrors:
    # SilverStripe's DBField magic methods
    - '#Access to an undefined property SilverStripe\\ORM\\FieldType\\DBField::\$value#'
    - '#Access to an undefined property SilverStripe\\ORM\\FieldType\\DBField::\$isChanged#'

  # Type hints for better analysis
  stubFiles:
    # Add any stub files here if needed
