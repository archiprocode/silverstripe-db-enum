{
    "name": "archipro/silverstripe-db-enum",
    "description": "Smart DB types for SilverStripe CMS: JSON columns, PHP Enum support, and intelligent DateTime casting",
    "type": "silverstripe-vendormodule",
    "keywords": [
        "silverstripe",
        "CMS",
        "json",
        "enum",
        "datetime",
        "database",
        "types"
    ],
    "license": "BSD-3-Clause",
    "require": {
        "silverstripe/framework": "^5.0"
    },
    "require-dev": {
        "php": "^8.1",
        "phpunit/phpunit": "^9.6",
        "squizlabs/php_codesniffer": "^3.7",
        "silverstripe/standards": "^1",
        "phpstan/phpstan": "^1.10",
        "phpstan/extension-installer": "^1.3",
        "cambis/silverstan": "^0.3"
    },
    "autoload": {
        "psr-4": {
            "ArchiPro\\Silverstripe\\DBEnum\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ArchiPro\\Silverstripe\\DbEnum\\Tests\\": "tests/php/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse",
        "phpstan-baseline": "phpstan analyse --generate-baseline",
        "phpcs": "phpcs src tests --standard=phpcs.xml.dist",
        "phpcbf": "phpcbf src tests --standard=phpcs.xml.dist",
        "lint": "find src tests -name '*.php' -print0 | xargs -0 -n1 php -l",
        "check": [
            "@lint",
            "@phpcs",
            "@phpstan",
            "@test"
        ]
    },
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
